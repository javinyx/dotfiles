font-family = DepartureMono Nerd Font Mono
font-size = 16.5

theme = light:emerald-dialog,dark:emerald-battle
background-opacity = 1

window-padding-x = 18
window-padding-y = 18,30
window-padding-balance = false
macos-titlebar-style = transparent

macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = #f8f8f8
macos-icon-screen-color = #186840,#50d890

confirm-close-surface = false

cursor-style = block
cursor-style-blink = false

custom-shader = shaders/tall-grass.glsl
custom-shader = shaders/shiny-sparkle.glsl
custom-shader = shaders/gba-lcd.glsl
