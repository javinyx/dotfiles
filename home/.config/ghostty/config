font-family = DepartureMono Nerd Font Mono
font-size = 16.5

theme = unova-black
background-opacity = 1

window-padding-x = 18
window-padding-y = 18,30
window-padding-balance = false
macos-titlebar-style = transparent

macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = #f8f8f8
macos-icon-screen-color = #182028,#40b8f8

confirm-close-surface = false

cursor-style = block
cursor-style-blink = false

custom-shader = shaders/castelia-skyline.glsl
custom-shader = shaders/quick-attack.glsl
custom-shader = shaders/shiny-sparkle.glsl
custom-shader = shaders/encounter.glsl
custom-shader = shaders/ds-lcd.glsl
