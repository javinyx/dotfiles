[user]
    name = Javin Barone

[init]
    defaultBranch = main

[core]
    editor = code --wait
    pager = delta
    fsmonitor = true
    untrackedCache = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true

[push]
    autoSetupRemote = true

[pull]
    ff = only

[fetch]
    prune = true

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictStyle = zdiff3

[rebase]
    autoSquash = true
    updateRefs = true

[rerere]
    enabled = true

[branch]
    sort = -committerdate

[gpg]
    format = ssh

[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
    allowedSignersFile = ~/.config/git/allowed_signers

[commit]
    gpgSign = true
    verbose = true

[tag]
    gpgSign = true

[includeIf "gitdir:~/Projects/Work/"]
    path = ~/.config/git/work.inc

[includeIf "gitdir:~/Projects/Personal/"]
    path = ~/.config/git/personal.inc

[includeIf "gitdir:~/Documents/Obsidian/"]
    path = ~/.config/git/personal.inc
