font-family = Monocraft
font-size = 15

# Bespoke themes live in ~/.config/ghostty/themes and take precedence over the
# ones shipped inside Ghostty.app. Swap to game-boy for the four-shade DMG look.
theme = arcade-cabinet
# theme = game-boy
background-opacity = 0.98

window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
macos-titlebar-style = transparent

cursor-style = block
cursor-style-blink = false

# Shaders run in the order listed, each receiving the previous one's output.
# starfield must precede arcade-crt: it decides where to draw by comparing each
# pixel to the background colour, which the CRT pass alters. cursor_blaze sits
# before the CRT so the trail gets scanlined along with everything else.
custom-shader = shaders/starfield.glsl
custom-shader = shaders/cursor_blaze.glsl
custom-shader = shaders/arcade-crt.glsl

# Other passes, all verified to compile. Drop any line above to lighten the load.
#   shaders/coin-flash.glsl  gold ring on each cursor move - use instead of
#                            cursor_blaze rather than alongside it
#   shaders/dot-matrix.glsl  heavier upstream CRT: aberration, glow, dot mask
#   shaders/gameboy.glsl     four-shade DMG quantiser, with theme = game-boy

custom-shader-animation = true
